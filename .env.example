# ── Recommended: Claude API (auto-selected when key is present) ──
ANTHROPIC_API_KEY=your_key_here

# ── Alternative backends (only used if ANTHROPIC_API_KEY is not set) ──
# LLM_BACKEND=ollama          # use a local Ollama server
# LLM_BACKEND=transformers    # use a local HuggingFace model (slow, low quality)

# HuggingFace model (only for transformers backend)
HF_MODEL=google/flan-t5-base

# Ollama settings (only for ollama backend)
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434
